<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>PdmTool</AssemblyName>
    <RootNamespace>PdmTool</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PdmInstallDir Condition="'$(PdmInstallDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS PDM\</PdmInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="EPDM.Interop.epdm">
      <HintPath>$(PdmInstallDir)EPDM.Interop.epdm.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="EPDM.Interop.EPDMResultCode">
      <HintPath>$(PdmInstallDir)EPDM.Interop.EPDMResultCode.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
