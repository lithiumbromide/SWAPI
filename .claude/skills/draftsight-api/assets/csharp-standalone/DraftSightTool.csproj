<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>DraftSightTool</RootNamespace>
    <AssemblyName>DraftSightTool</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <DraftSightTlb Condition="'$(DraftSightTlb)' == ''">C:\Program Files\Dassault Systemes\DraftSight\APISDK\tlb</DraftSightTlb>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DraftSight.Interop.dsAutomation">
      <HintPath>$(DraftSightTlb)\DraftSight.Interop.dsAutomation.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>
